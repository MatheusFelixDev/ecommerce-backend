NODE_ENV=production
LOG_LEVEL=info

PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/DATABASE_NAME

JWT_SECRET=replace_with_a_strong_secret_min_32_chars
JWT_EXPIRES_IN=1d
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com,https://admin.seudominio.com

MELHOR_ENVIO_ENABLED=true
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br
MELHOR_ENVIO_ACCESS_TOKEN=replace_with_real_melhor_envio_access_token
MELHOR_ENVIO_USER_AGENT=ecommerce-backend (your-production-email@example.com)
MELHOR_ENVIO_ORIGIN_ZIP_CODE=30140071

MERCADO_PAGO_ENABLED=true
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=replace_with_real_mercado_pago_access_token
MERCADO_PAGO_PUBLIC_KEY=replace_with_real_mercado_pago_public_key
MERCADO_PAGO_WEBHOOK_SECRET=replace_with_real_mercado_pago_webhook_secret
MERCADO_PAGO_SUCCESS_URL=https://api.your-domain.com/payments/success
MERCADO_PAGO_FAILURE_URL=https://api.your-domain.com/payments/failure
MERCADO_PAGO_PENDING_URL=https://api.your-domain.com/payments/pending
MERCADO_PAGO_NOTIFICATION_URL=https://api.your-domain.com/api/payments/webhooks/mercado-pago
